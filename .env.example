# Local development runs entirely against the Firebase Emulator Suite, so these
# values are placeholders — the emulators do not validate them. Do not point a
# development build at the live project (see CLAUDE.md).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=qjume-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=qjume-local
VITE_FIREBASE_STORAGE_BUCKET=qjume-local.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=qjume-local
# Web push public key, from Firebase console > Cloud Messaging > Web Push
# certificates. Push is inert without it.
VITE_FIREBASE_VAPID_KEY=

# Set to "false" to run a dev build against a real project. Deliberately awkward.
VITE_USE_EMULATORS=true
