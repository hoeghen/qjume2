# Plain (non-secret) function config for qjume-d483a. Loaded automatically
# by Firebase on deploy for this project — never commit real secrets here;
# those go through `firebase functions:secrets:set` instead. See CLAUDE.md
# decision 10.

GEOCODING_PROVIDER=opencage
# Sending domain qjume.dk is verified in Resend. Inbound mail to qjume.dk
# (info@ included) is forwarded to carverdk@gmail.com by Cloudflare Email
# Routing, so replies to this address reach a person.
EMAIL_FROM="Qjume <info@qjume.dk>"

# Where notification links point (lib/config.ts). Unset, it falls back to the
# local dev server, so tapping a real push on a phone opened 127.0.0.1.
APP_BASE_URL=https://qjume.dk

# Payments run on the stub provider until real Stripe keys are ready. The
# billing UI and plan-change flow work end to end against it - no money
# moves, but nothing is blocked on Stripe either. See lib/secrets.ts and
# CLAUDE.md decision 10. Switching PAYMENTS_PROVIDER to `stripe` and setting
# STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET (via `firebase functions:secrets:set`)
# plus STRIPE_PRICE_ID here is what turns real payments back on.
#
# PAYMENTS_STUB_SECRET is deliberately left unset: stubPayments() falls back
# to its own baked-in default when it is, and since the stub never moves
# real money there is nothing worth protecting behind a secret here — see
# stub.ts. Set PAYMENTS_STUB_SECRET here only if that default ever needs to
# change.
PAYMENTS_PROVIDER=stub

# Still needed before real Stripe payments can be switched on:
# PAYMENTS_PROVIDER=stripe
# STRIPE_PRICE_ID=

# MobilePay (Vipps MobilePay Recurring API) — the first real provider to go
# live; Stripe stays supported beside it. See CLAUDE.md decision 12. To turn
# it on, in this order (a deploy that binds a secret that does not exist yet
# fails):
#   1. firebase functions:secrets:set MOBILEPAY_CLIENT_ID
#      firebase functions:secrets:set MOBILEPAY_CLIENT_SECRET
#      firebase functions:secrets:set MOBILEPAY_SUBSCRIPTION_KEY
#      firebase functions:secrets:set MOBILEPAY_WEBHOOK_SECRET   # placeholder for now
#   2. Uncomment the lines below and deploy.
#   3. Register the webhook (prints the real secret), then set
#      MOBILEPAY_WEBHOOK_SECRET again with it and deploy once more:
#        node functions/scripts/mobilepay-webhook.mjs register
#   4. Test against apitest.vipps.no first; MOBILEPAY_ENV=production when done.
# MOBILEPAY_PRICE_ORE is what MobilePay actually charges each month, in øre
# and including VAT: 12500 is SUBSCRIPTION_PRICE_DKK (100 kr) plus 25% moms.
# PAYMENTS_PROVIDER=mobilepay
# MOBILEPAY_MSN=
# MOBILEPAY_ENV=test
# MOBILEPAY_PRICE_ORE=12500
# The URL `firebase deploy` prints for mobilepayWebhook, exactly as registered:
# MOBILEPAY_WEBHOOK_URL=https://us-central1-qjume-d483a.cloudfunctions.net/mobilepayWebhook
