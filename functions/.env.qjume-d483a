# Plain (non-secret) function config for qjume-d483a. Loaded automatically
# by Firebase on deploy for this project — never commit real secrets here;
# those go through `firebase functions:secrets:set` instead. See CLAUDE.md
# decision 10.

GEOCODING_PROVIDER=opencage
# Sending domain qjume.dk is verified in Resend. Inbound mail to qjume.dk
# (info@ included) is forwarded to carverdk@gmail.com by Cloudflare Email
# Routing, so replies to this address reach a person.
EMAIL_FROM="Qjume <info@qjume.dk>"

# Where notification links point (lib/config.ts). Unset, it falls back to the
# local dev server, so tapping a real push on a phone opened 127.0.0.1.
APP_BASE_URL=https://qjume.dk

# Payments run on Stripe. STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET live
# in Secret Manager, bound because STRIPE_SECRETS_EXIST is true in
# lib/secrets.ts; STRIPE_PRICE_ID is below. See CLAUDE.md decision 10.
# The stub provider (no money moves) is one line away if Stripe ever has
# to be switched off.
#
# PAYMENTS_STUB_SECRET is deliberately left unset: stubPayments() falls back
# to its own baked-in default when it is, and since the stub never moves
# real money there is nothing worth protecting behind a secret here — see
# stub.ts. Set PAYMENTS_STUB_SECRET here only if that default ever needs to
# change.
#PAYMENTS_PROVIDER=stub

# Stripe, in test mode until the live keys replace the test ones in Secret
# Manager and STRIPE_PRICE_ID below is swapped for the live price. The price
# is 100 kr/month before VAT; 25 % Danish VAT is added at checkout (see
# danishVatRate in billing/stripe.ts).
PAYMENTS_PROVIDER=stripe
STRIPE_PRICE_ID=price_1UQrkwK7AgDSVrMsDaCvmuoz
