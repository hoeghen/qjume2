{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": ".."
  },
  "include": ["src/**/*.ts", "../src/types/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
