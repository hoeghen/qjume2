{
  "rules": {
    ".read": false,
    ".write": false,
    "status": {
      "$shopId": {
        "$queueId": {
          ".read": true,
          "$connectionId": {
            ".write": "auth != null",
            ".validate": "newData.hasChild('at') || !newData.exists()",
            "at": { ".validate": "newData.isNumber()" },
            "stationId": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
