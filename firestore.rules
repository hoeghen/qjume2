rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isShopOwner(shopId) {
      return signedIn()
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid
           == request.auth.uid;
    }

    // Anyone who may work the counter. Staff are a paid feature, so a staff
    // record on a free shop grants nothing — otherwise a downgrade would leave
    // staff quietly still able to serve.
    function canServe(shopId) {
      return isShopOwner(shopId)
        || (signedIn()
            && get(/databases/$(database)/documents/shops/$(shopId)).data.plan
               == 'paid'
            && exists(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid)));
    }

    // The only queue field a client may write is `status` — pausing, resuming
    // and reopening. Everything else goes through a Cloud Function:
    //
    //  - counters (waitingCount, lastPosition, …) are queue state that only
    //    joinQueue and callNext may move;
    //  - settings go through updateQueue, which re-geocodes when the address
    //    changes. A client write could otherwise change the address while
    //    leaving stale coordinates, listing the queue where it no longer is.
    function changesOnlyStatus() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status']);
    }

    function validStatus() {
      return request.resource.data.status in
        ['open', 'drainMode', 'paused', 'unavailable', 'closed'];
    }

    // Shops and queues are publicly readable: customers discover queues before
    // signing in, and joining is anonymous by default.
    // ----------------------------------------------------------------------
    // `plan` is server-owned, and this is the hinge the whole free tier hangs
    // on. Every limit — one queue, twenty waiting, one server at a time — is
    // enforced by a Cloud Function reading shop.plan. An owner who could write
    // that field would lift all of them in a single request, and the limits
    // would be decoration. It changes only through a verified payment.
    //
    // `profile` is a paid feature, so it is gated on the plan rather than on
    // the UI merely hiding the form.
    // ----------------------------------------------------------------------
    function keepsServerOwnedShopFields() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.plan == resource.data.plan;
    }

    function profileAllowed() {
      return resource.data.plan == 'paid'
        || !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['profile']);
    }

    match /shops/{shopId} {
      allow read: if true;
      // Nobody starts paid, whatever they put in the request.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.plan == 'free';
      allow update: if isShopOwner(shopId)
        && keepsServerOwnedShopFields()
        && profileAllowed();
      allow delete: if isShopOwner(shopId);

      // Staff records are server-written: adding one is a paid feature, and a
      // client that could write here would grant itself serving rights.
      // Readable by the owner, and by the person it names, so a staff member's
      // app can tell it has access.
      match /staff/{uid} {
        allow read: if isShopOwner(shopId)
          || (signedIn() && request.auth.uid == uid);
        allow write: if false;
      }

      match /queues/{queueId} {
        allow read: if true;
        // Creation is server-only: the free-tier "one active queue" limit is
        // counted in `createQueue`, and a client create would walk straight
        // past it. Invariant 5.
        allow create: if false;
        // Pausing and reopening is running the counter, so staff may do it.
        allow update: if canServe(shopId)
          && changesOnlyStatus()
          && validStatus();
        allow delete: if isShopOwner(shopId);

        // ------------------------------------------------------------------
        // Tickets are server-write-only. This is the app's main abuse vector:
        // a customer who could write their own ticket could set `serving` and
        // advance themselves past everyone waiting. Every transition goes
        // through a Cloud Function, which uses the Admin SDK and bypasses
        // these rules. There is deliberately no client write path at all —
        // not even a narrow one for the shop owner. See CLAUDE.md invariant 1.
        //
        // Reads are public, and have to be. The in-shop monitor shows the next
        // few customers by name to a room of strangers (PRD 5.7), and a
        // customer works out their own place by counting the tickets ahead of
        // them. Both happen without signing in. Nothing here identifies a
        // person beyond the name they chose to be called by.
        // ------------------------------------------------------------------
        match /tickets/{ticketId} {
          allow read: if true;
          allow write: if false;

          // Contact details and the resume code — which is a credential, not
          // a label. Only the holder and the shop serving them may read it,
          // and nobody may write it from a client.
          match /private/{document} {
            allow read: if canServe(shopId)
              || (signedIn() && (
                   resource.data.customerUid == request.auth.uid
                   || resource.data.anonymousId == request.auth.uid
                 ));
            allow write: if false;
          }
        }

        // Publicly readable so the in-shop monitor can display the current
        // pairings without signing in. Writes are server-only: the free tier
        // allows one server at a time, enforced in `claimStation`, and
        // `currentTicketId` is queue state that only `callNext` may set.
        match /stations/{stationId} {
          allow read: if true;
          allow write: if false;
        }
      }
    }

    // Discovery searches every shop's queues at once, which is a collection
    // group query. The path-scoped rule above does not cover that scope, so it
    // is granted here — read-only, matching the public readability queues
    // already have at their own path.
    match /{path=**}/queues/{queueId} {
      allow read: if true;
    }

    match /customers/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Anything not matched above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
